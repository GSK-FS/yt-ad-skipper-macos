# ====================================================================
# MACOS & XCODE NATIVE (Swift App) 🍏 
# ====================================================================
# Xcode build artifacts & local user states
DerivedData/
*.xcuserstate
project.xcworkspace/xcuserdata/
*.xcuserdatad
*.xcscmblueprint

# Crash logs and diagnostic captures
*.crash
*.gpu
*.memgraph

# macOS OS-level system metadata
.DS_Store
.AppleDouble
.LSOverride
Icon_
._*

# ====================================================================
# NODE & BROWSER EXTENSION (JavaScript / TypeScript) 🌐 
# ====================================================================
# Dependencies
node_modules/
jspm_packages/
.pnpm-store/

# Local configuration & environment variables (CRITICAL FOR SECURITY)
.env
.env.*
!.env.example

# Common web bundler build outputs & caches (Vite, Webpack, Parcel)
dist/
build/
.cache/
.parcel-cache/
.vite/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Logs & Runtime Diagnostics
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pids
*.pid
*.seed
*.pid.lock
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Linting & Type Caches
.eslintcache
.stylelintcache
*.tsbuildinfo

# ====================================================================
# IDE & CODE EDITORS 💻 
# ====================================================================
.vscode/
.idea/
*.swp
*.suo
